{
  "name": "gcmuse",
  "dockerFile": "Dockerfile",

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",

  "runArgs": [
    "--env-file",
    ".devcontainer/.env",
    "--env-file",
    ".devcontainer/.env.secrets",
    "--network",
    "host"
  ],

  // Lifecycle hooks
  "initializeCommand": "if [ -f .devcontainer/initializeCommand.sh ]; then .devcontainer/initializeCommand.sh; fi",
  "postCreateCommand": "if [ -f .devcontainer/postCreateCommand.sh ]; then .devcontainer/postCreateCommand.sh; fi",
  "postStartCommand": "if [ -f .devcontainer/postStartCommand.sh ]; then .devcontainer/postStartCommand.sh; fi",

  // Customizations
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "vitest.explorer",
        "ms-playwright.playwright",
        "dbaeumer.vscode-eslint",
        "EditorConfig.EditorConfig",
        "oxc.oxc-vscode",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
